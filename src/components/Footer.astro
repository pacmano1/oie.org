---
import Icon from './Icon.astro';

const year = new Date().getFullYear();

const social = [
  { name: 'GitHub',   icon: 'github'   as const, href: 'https://github.com/OpenIntegrationEngine' },
  { name: 'LinkedIn', icon: 'linkedin' as const, href: 'https://www.linkedin.com/company/open-integration-engine' },
  { name: 'Discord',  icon: 'discord'  as const, href: 'https://discord.gg/azdehW2Zrx' },
  { name: 'Email',    icon: 'envelope' as const, href: 'mailto:info@openintegrationengine.org' },
];
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <img src="/images/oie-mark.svg" alt="" width="48" height="48" />
      <div>
        <div class="site-footer__brand-name">Eclipse Open Integration Engine<sup>™</sup></div>
        <div class="site-footer__brand-tag">Free. Open Source. Trusted.</div>
      </div>
    </div>

    <nav class="site-footer__social" aria-label="Social links">
      {social.map((s) => (
        <a href={s.href} target={s.href.startsWith('mailto:') ? undefined : '_blank'} rel={s.href.startsWith('mailto:') ? undefined : 'noopener'} aria-label={s.name}>
          <Icon name={s.icon} />
        </a>
      ))}
    </nav>

    <div class="site-footer__eclipse">
      <div class="site-footer__eclipse-col">
        <a class="site-footer__logo" href="https://www.eclipse.org/" target="_blank" rel="noopener" aria-label="Eclipse Foundation">
          <img class="site-footer__ef" src="/images/eclipse-foundation.svg" alt="" aria-hidden="true" width="283" height="91" />
        </a>
        <p>
          Eclipse Open Integration Engine is a project of the Eclipse Foundation, an international
          non-profit that provides neutral, community-owned governance for open source software.
        </p>
      </div>
      <div class="site-footer__eclipse-col">
        <a class="site-footer__logo" href="https://www.eclipse.org/projects/dev_process/" target="_blank" rel="noopener" aria-label="Eclipse Incubation">
          <img class="site-footer__incubation" src="/images/eclipse-incubation.svg" alt="" aria-hidden="true" width="468" height="169" />
        </a>
        <p>
          The project is in the incubation phase of the
          <a href="https://www.eclipse.org/projects/dev_process/" target="_blank" rel="noopener">Eclipse Development Process</a>,
          working through the Foundation's processes and IP review.
        </p>
      </div>
    </div>

    <div class="site-footer__meta">
      <p>© {year} The Open Integration Engine Project Authors. <a href="/privacy/">Privacy Policy</a></p>
      <p class="site-footer__disclaimer">
        Eclipse, Eclipse Foundation, Open Integration Engine, and OIE are trademarks of Eclipse
        Foundation AISBL. This project is not affiliated with, endorsed by, or sponsored by NextGen
        Healthcare, Inc. or Innovar Healthcare. Mirth® and Mirth® Connect are registered trademarks
        of NextGen Healthcare, Inc. BridgeLink is a trademark of Innovar Healthcare.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-footer-bg);
    color: var(--color-footer-text);
    padding: 3rem 0 2rem;
    margin-top: 4rem;
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "brand social"
      "eclipse eclipse"
      "meta meta";
    gap: 2rem;
    align-items: center;
  }

  .site-footer__brand {
    grid-area: brand;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .site-footer__brand img { border-radius: 6px; }

  .site-footer__brand-name {
    font-weight: 700;
    color: var(--color-footer-heading);
    font-size: 1.1rem;
  }
  .site-footer__brand-tag { font-size: 0.85rem; }

  .site-footer__social {
    grid-area: social;
    display: flex;
    gap: 1rem;
  }

  .site-footer__social a {
    color: var(--color-footer-link);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .site-footer__social a:hover {
    color: var(--color-footer-link-hover);
    background: rgba(8, 145, 178, 0.08);
  }

  .site-footer__eclipse {
    grid-area: eclipse;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    border-top: 1px solid var(--color-divider);
    padding-top: 1.5rem;
  }
  .site-footer__eclipse-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
  }
  .site-footer__eclipse img { display: block; height: auto; }
  .site-footer__logo {
    display: flex;
    align-items: center;
    min-height: 60px;
  }
  .site-footer__ef { width: 112px; }
  /* Its viewBox carries ~31% clear space, so the box is wider to match EF's artwork. */
  .site-footer__incubation { width: 164px; }
  .site-footer__eclipse p {
    margin: 0;
    font-size: 0.875rem;
  }

  .site-footer__meta {
    grid-area: meta;
    border-top: 1px solid var(--color-divider);
    padding-top: 1.5rem;
    font-size: 0.875rem;
  }
  .site-footer__meta p { margin-bottom: 0.5rem; }
  .site-footer__meta a { color: var(--color-footer-link); }
  .site-footer__meta a:hover { color: var(--color-footer-link-hover); }

  .site-footer__disclaimer {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 700px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      grid-template-areas:
        "brand"
        "social"
        "eclipse"
        "meta";
    }
    .site-footer__eclipse { grid-template-columns: 1fr; gap: 1.5rem; }
  }
</style>
