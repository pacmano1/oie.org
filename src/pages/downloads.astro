---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const currentRelease = {
  version: '4.6.0',
  url: 'https://github.com/OpenIntegrationEngine/engine/releases/tag/v4.6.0',
};
---

<BaseLayout title="Downloads - Eclipse Open Integration Engine" description="Download the latest Open Integration Engine release.">
  <article class="container-narrow page">
    <PageHero
      title="Downloads"
      lead="Open Integration Engine is stable and ready for production use. The 4.6.0 release is recommended for most users."
    />

    <section>
      <p>Installers are available including:</p>
      <ul>
        <li>A full version <strong>with a bundled JRE</strong> for fast, hassle-free setup</li>
        <li>A lightweight version <strong>without a JRE</strong> for custom environments</li>
      </ul>
    </section>

    <section class="card card--padded download">
      <p class="release-label">Current stable release</p>
      <h2>Open Integration Engine {currentRelease.version}</h2>
      <p class="release-note">Recommended for production use.</p>
      <p>
        <a class="button" href={currentRelease.url} target="_blank" rel="noopener">
          Download v{currentRelease.version} from GitHub
        </a>
      </p>
      <p class="meta">
        <a href="/news/oie-4-6-0/">Read what's new in 4.6.0</a>
      </p>
      <p class="meta">
        All releases: <a href="https://github.com/OpenIntegrationEngine/engine/releases" target="_blank" rel="noopener">github.com/OpenIntegrationEngine/engine/releases</a>
      </p>
      <p class="incubation-note">
        <a href="https://www.eclipse.org/projects/dev_process/" target="_blank" rel="noopener" aria-label="Eclipse Incubation">
          <img src="/images/eclipse-incubation.svg" alt="" aria-hidden="true" width="468" height="169" />
        </a>
        <span>
          Releases are production builds; incubation refers to the project's stage at the Foundation.
          Eclipse Open Integration Engine is in the incubation phase of the
          <a href="https://www.eclipse.org/projects/dev_process/" target="_blank" rel="noopener">Eclipse Development Process</a>.
        </span>
      </p>
    </section>

    <p class="license-note">
      Released under the <a href="https://www.mozilla.org/en-US/MPL/2.0/" target="_blank" rel="noopener">Mozilla Public License 2.0</a>.
    </p>
  </article>
</BaseLayout>

<style>
  .page { padding: 3rem 0 4rem; }
  .page :global(.lead) { font-size: 1.15rem; }
  section { margin-bottom: 1.5rem; }
  .download { text-align: center; }
  .download h2 { margin: 0.25rem 0 0.5rem; }
  .incubation-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    text-align: left;
    margin: 1.5rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-divider);
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .incubation-note a { flex-shrink: 0; display: block; }
  .incubation-note img { display: block; width: 104px; height: auto; }
  @media (max-width: 640px) {
    .incubation-note { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
  }
  .download .release-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-headings);
    margin: 0;
  }
  .download .release-note {
    font-size: 0.95rem;
    color: var(--color-base);
    margin: 0 0 1rem;
  }
  .download .meta { font-size: 0.9rem; color: var(--color-base); margin-bottom: 0; }
  .license-note { text-align: center; font-size: 0.9rem; color: var(--color-base); margin-top: 1.5rem; }
</style>
