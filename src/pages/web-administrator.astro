---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';

type Shot = { img: string; caption: string; alt: string };

const shots: Shot[] = [
  {
    img: '/images/webadmin/03-message-tree.png',
    caption: 'Message browser',
    alt: 'Message browser with the message tree',
  },
  {
    img: '/images/webadmin/04-channel-editor.png',
    caption: 'Channel editor',
    alt: 'Channel editor in the web administrator',
  },
  {
    img: '/images/webadmin/05-source-code-search.png',
    caption: 'Source Code Search plugin',
    alt: 'Source Code Search plugin running in the web administrator',
  },
  {
    img: '/images/webadmin/06-extensions.png',
    caption: 'Extensions',
    alt: 'Extensions page in the web administrator',
  },
];
---

<BaseLayout
  title="Web Administrator - Eclipse Open Integration Engine"
  description="A web administrator for Open Integration Engine: administer it from any browser. Open source under MPL 2.0, with plugins recognized at runtime in both the desktop and web clients."
>
  <article class="container page">
    <PageHero title="Web Administrator" />

    <details class="context card card--hover">
      <summary>Why does a web interface get its own page?</summary>
      <div class="context__body">
        <p>
          Mirth and its derivatives including Open Integration Engine have always required the use
          of a java tool to administer the server and the process to run that tool was this:
        </p>
        <ol>
          <li>Install an Administration Tool Launcher which is not the administrator.</li>
          <li>The launcher brings its own Java runtime or you can use yours if yours has JavaFX.</li>
          <li>The launcher downloads the administrator which is close to 90 MB.</li>
          <li>The administrator opens and you log in.</li>
        </ol>
        <p class="context__now">With the web administrator, you open a browser and log in.</p>
      </div>
    </details>

    <p class="page-lead">
      Open Integration Engine can be administered from a browser. The web administrator is open
      source under MPL 2.0 and installs as a standard extension, and the plugins you install are
      the same ones the desktop client runs so there is no separate web build to maintain.
    </p>

    <section class="more">
      <h2 class="section-title">A sampling of extra features</h2>
      <dl class="more__grid">
        <div>
          <dt>Command palette</dt>
          <dd>Press Cmd-K or Ctrl-K to jump to any view, channel, or command from anywhere.</dd>
        </div>
        <div>
          <dt>Content compare</dt>
          <dd>Compare any two pieces of stored message content side by side in a diff viewer.</dd>
        </div>
        <div>
          <dt>Card dashboard</dt>
          <dd>A card view of the dashboard as an alternative to the status table, grouped by channel group, tag, or state.</dd>
        </div>
        <div>
          <dt>Guided builders</dt>
          <dd>Step-by-step wizards for building a channel or an alert, as an alternative to the classic editors.</dd>
        </div>
        <div>
          <dt>Linkable views</dt>
          <dd>Every view has a real URL, so you can bookmark a channel editor or paste a link to it for a colleague.</dd>
        </div>
        <div>
          <dt>Time zones</dt>
          <dd>Switch every timestamp between the engine's time zone, your own, and UTC.</dd>
        </div>
        <div>
          <dt>Highlighted content</dt>
          <dd>Message content is syntax highlighted, and hovering an HL7 field tells you what it is.</dd>
        </div>
        <div>
          <dt>Script editor</dt>
          <dd>A modern code editor for scripts, with autocompletion and find and replace.</dd>
        </div>
        <div>
          <dt>Any device</dt>
          <dd>Works on any device with a browser, including a tablet or a workstation you can't install software on.</dd>
        </div>
        <div>
          <dt>One engine or many</dt>
          <dd>Install it into a single engine, or run one copy that fronts all of your engines and pick which one at login.</dd>
        </div>
      </dl>
    </section>

    <h2 class="section-title">Sample screenshots</h2>

    <section class="lead-shot">
      <p class="lead-shot__caption">Dashboard, light and dark</p>
      <div class="lead-shot__pair">
        <figure class="screen">
          <img src="/images/webadmin/01-dashboard-light.png" alt="Web administrator dashboard, light theme" loading="lazy" />
        </figure>
        <figure class="screen">
          <img src="/images/webadmin/02-dashboard-dark.png" alt="Web administrator dashboard, dark theme" loading="lazy" />
        </figure>
      </div>
    </section>


    <div class="gallery">
      {shots.map((s) => (
        <figure class="shot">
          <figcaption>{s.caption}</figcaption>
          <div class="screen">
            <img src={s.img} alt={s.alt} loading="lazy" />
          </div>
        </figure>
      ))}
    </div>

    <section class="extend">
      <h2>How do I add web capabilities to my new or existing plugin?</h2>
      <p>
        The web administrator does not privilege its own features. The connectors, data types,
        transformer steps, attachment viewers, and dashboard tabs it ships with are all plugins,
        loaded through the same mechanism a plugin of yours uses. A plugin is a folder holding a
        manifest and a compiled React entry, dropped into a plugins directory and picked up on the
        next browser refresh.
      </p>
      <p>
        If you already have an engine extension with a Swing panel, the engine half stays as it is
        and you write only the web UI, calling the REST endpoints you already have. Every Swing
        extension point has a web equivalent: dashboard tabs and columns, settings panels, channel
        tabs and tasks, transformer steps and filter rules, attachment viewers, connector panels,
        data types, transmission modes, resource types, and the authorization controller.
      </p>
      <a
        class="extend__link"
        href="https://github.com/gibson9583/oie-web-client/blob/main/web-administrator/PLUGINS.md"
        target="_blank"
        rel="noopener"
      >
        Read the plugin development guide
        <Icon name="arrow-up-right" size={13} />
      </a>
    </section>

    <div class="cta">
      <a class="button" href="https://github.com/gibson9583/oie-web-support-plugin" target="_blank" rel="noopener">
        Get the Web Support plugin
        <Icon name="arrow-up-right" size={13} />
      </a>
      <a class="cta__secondary" href="/plugins/">Browse the plugins</a>
    </div>
  </article>
</BaseLayout>

<style>
  .page { padding: 3rem 0 4rem; }
  .page-lead { max-width: 720px; margin: 0 auto 2.5rem; }

  details.context {
    max-width: 720px;
    margin: -1.5rem auto 1.75rem;
    background: #e6f1f9;
    border-color: #c8dcea;
  }
  details.context:hover { border-color: #a9cbe2; }
  .context > summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    font-weight: 600;
    color: var(--color-headings);
  }
  .context > summary::-webkit-details-marker { display: none; }
  .context > summary::after {
    content: '';
    flex: none;
    width: 8px;
    height: 8px;
    margin-top: -4px;
    border-right: 2px solid var(--color-text-muted);
    border-bottom: 2px solid var(--color-text-muted);
    transform: rotate(45deg);
    transition: transform 0.15s ease;
  }
  .context[open] > summary::after { margin: 4px 0 0; transform: rotate(-135deg); }
  .context__body { padding: 0 1.25rem 1.25rem; }
  .context__body > *:last-child { margin-bottom: 0; }
  .context p { color: var(--color-base); line-height: 1.6; margin: 0 0 1rem; }
  .context ol {
    color: var(--color-base);
    line-height: 1.6;
    margin: 0 0 1.5rem;
    padding-left: 1.25rem;
  }
  .context li { margin: 0 0 0.4rem; }
  .context__now { font-weight: 600; margin-bottom: 0.75rem; }

  .lead-shot { margin: 0 0 2.5rem; }
  .lead-shot__pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .screen {
    margin: 0;
    display: block;
    background: var(--color-light-grey);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 4px rgba(24, 51, 67, 0.06), 0 14px 34px rgba(24, 51, 67, 0.16);
  }
  .screen img { display: block; width: 100%; height: auto; }

  .more { max-width: 720px; margin: 0 auto 3rem; }
  .section-title { font-size: 1.35rem; margin: 0 0 1.25rem; text-align: center; }
  .more p { color: var(--color-base); line-height: 1.6; margin: 0 0 1rem; }
  .more__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem 2rem;
    margin: 0;
  }
  .more__grid dt {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-headings);
    margin: 0 0 0.15rem;
  }
  .more__grid dd {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-base);
  }

  .gallery {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .shot { margin: 0; }

  .lead-shot__caption,
  .shot figcaption {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
    text-align: center;
    margin: 0 0 0.75rem;
  }

  .extend { max-width: 720px; margin: 3.5rem auto 0; }
  .extend h2 { font-size: 1.35rem; margin: 0 0 1rem; }
  .extend p { color: var(--color-base); line-height: 1.6; margin: 0 0 1rem; }
  .extend__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
  }

  .cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 3rem;
  }
  .button { display: inline-flex; align-items: center; gap: 0.35rem; }
  .cta__secondary { font-weight: 600; }

  @media (max-width: 720px) {
    .more__grid { grid-template-columns: 1fr; }
    .lead-shot__pair { grid-template-columns: 1fr; }
    .gallery { gap: 2rem; }
  }
</style>
